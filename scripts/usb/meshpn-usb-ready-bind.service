[Unit]
Description=Expose prepared Radxa USB gadget after DHCP startup
Requires=usb-gadget.service
Wants=dnsmasq.service clean-vpn-usb-rescue-address.service
After=usb-gadget.service dnsmasq.service clean-vpn-usb-rescue-address.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/meshpn-usb-ready-bind.py --bind
RemainAfterExit=yes
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
