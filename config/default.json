{
  "role": "client",
  "metrics": {
    "enabled": true,
    "periodicReport": false,
    "reportInterval": 5000
  },
  "trafficStatsIntervalMs": 5000,
  "signallingServer": "ws://localhost:8080",
  "iceServers": [
    { "urls": "stun:stun.cloudflare.com:3478" },
    { "urls": "stun:global.stun.twilio.com:3478" },
    { "urls": "stun:stun.nextcloud.com:443" },
    { "urls": "stun:stun.l.google.com:19302" },
    { "urls": "stun:stun1.l.google.com:19302" }
  ],
  "turnServers": [
    {
      "urls": "turn:62.84.120.30:3478",
      "username": "meshuser",
      "credential": "meshpass"
    },
    {
      "urls": "turns:62.84.120.30:5349",
      "username": "meshuser",
      "credential": "meshpass"
    }
  ],
  "virtualNetwork": "10.200.0.0/16",
  "mtu": 1400,
  "enableTun": true,
  "dcMode": "reliable",
  "mesh": {
    "strictTransportOrdering": true
  },
  "multipathStrategy": "round-robin",
  "reorderWindowSize": 1000,
  "reorderTimeout": 5000,
  "transport": {
    "preferredOrder": ["webrtc", "quic", "websocket"]
  },
  "quic": {
    "portHopping": false,
    "portHoppingInterval": 30000
  },
  "signallingToken": "your-secret"
}
