+void SSL_CTX_meshvpn_clear_client_hello_extensions(SSL_CTX *ctx) {
+  if (ctx == nullptr) {
+    return;
+  }
+  ctx->meshvpn_client_hello_extra_extensions.clear();
+}
+
+int SSL_CTX_meshvpn_add_client_hello_extension(SSL_CTX *ctx, uint16_t ext_type,
+                                               const uint8_t *body,
+                                               size_t body_len) {
+  if (ctx == nullptr) {
+    return 0;
+  }
+  if (body_len > 65535) {
+    OPENSSL_PUT_ERROR(SSL, SSL_R_ERROR_ADDING_EXTENSION);
+    return 0;
+  }
+  for (const auto &existing : ctx->meshvpn_client_hello_extra_extensions) {
+    if (existing.first == ext_type) {
+      OPENSSL_PUT_ERROR(SSL, SSL_R_ERROR_ADDING_EXTENSION);
+      return 0;
+    }
+  }
+  std::vector<uint8_t> bytes;
+  if (body_len != 0) {
+    bytes.assign(body, body + body_len);
+  }
+  ctx->meshvpn_client_hello_extra_extensions.emplace_back(ext_type,
+                                                          std::move(bytes));
+  return 1;
+}
