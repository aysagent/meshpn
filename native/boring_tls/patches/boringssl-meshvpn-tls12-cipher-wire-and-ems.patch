+int SSL_CTX_set_meshvpn_tls12_client_cipher_wire_order(
+    SSL_CTX *ctx, const uint16_t *cipher_ids, size_t num_cipher_ids) {
+  if (ctx == nullptr) {
+    return 0;
+  }
+  ctx->meshvpn_tls12_client_cipher_wire_order.Reset();
+  if (num_cipher_ids == 0) {
+    return 1;
+  }
+  Span<const uint16_t> span(cipher_ids, num_cipher_ids);
+  if (!tls13_cipher_order_unique(span)) {
+    return 0;
+  }
+  return ctx->meshvpn_tls12_client_cipher_wire_order.CopyFrom(span) ? 1 : 0;
 }
 
+void SSL_CTX_set_meshvpn_suppress_extended_master_secret_clienthello(
+    SSL_CTX *ctx, int suppress) {
+  if (ctx == nullptr) {
+    return;
+  }
+  ctx->meshvpn_suppress_ems_clienthello = suppress != 0;
+}
