+static bool tls13_cipher_order_unique(Span<const uint16_t> list) {
+  if (list.size() < 2) {
+    return true;
+  }
+  for (size_t i = 0; i < list.size() - 1; ++i) {
+    for (size_t j = i + 1; j < list.size(); ++j) {
+      if (list[i] == list[j]) {
+        OPENSSL_PUT_ERROR(SSL, SSL_R_NO_CIPHERS_SPECIFIED);
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+int SSL_CTX_set_tls13_client_cipher_order(SSL_CTX *ctx,
+                                          const uint16_t *cipher_ids,
+                                          size_t num_cipher_ids) {
+  if (ctx == nullptr) {
+    return 0;
+  }
+  ctx->tls13_client_cipher_order.Reset();
+  if (num_cipher_ids == 0) {
+    return 1;
+  }
+  Span<const uint16_t> span(cipher_ids, num_cipher_ids);
+  if (!tls13_cipher_order_unique(span)) {
+    return 0;
+  }
+  for (size_t i = 0; i < span.size(); i++) {
+    const uint16_t id = span[i];
+    const SSL_CIPHER *candidate = SSL_get_cipher_by_value(id);
+    if (candidate == nullptr ||
+        SSL_CIPHER_get_min_version(candidate) > TLS1_3_VERSION ||
+        SSL_CIPHER_get_max_version(candidate) < TLS1_3_VERSION) {
+      OPENSSL_PUT_ERROR(SSL, SSL_R_NO_CIPHER_MATCH);
+      return 0;
+    }
+    if (!ssl_tls13_cipher_meets_policy(id, ctx->compliance_policy)) {
+      OPENSSL_PUT_ERROR(SSL, SSL_R_NO_CIPHER_MATCH);
+      return 0;
+    }
+  }
+  return ctx->tls13_client_cipher_order.CopyFrom(span) ? 1 : 0;
+}
