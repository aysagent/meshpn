+static bool meshvpn_sigalgs_cert_unique(Span<const uint16_t> list) {
+  if (list.size() < 2) {
+    return true;
+  }
+  for (size_t i = 0; i < list.size() - 1; ++i) {
+    for (size_t j = i + 1; j < list.size(); ++j) {
+      if (list[i] == list[j]) {
+        OPENSSL_PUT_ERROR(SSL, SSL_R_NO_CIPHER_MATCH);
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+int SSL_CTX_set_meshvpn_client_signature_algorithms_cert(
+    SSL_CTX *ctx, const uint16_t *prefs, size_t num_prefs) {
+  if (ctx == nullptr) {
+    return 0;
+  }
+  ctx->meshvpn_client_sigalgs_cert.Reset();
+  if (num_prefs == 0) {
+    return 1;
+  }
+  Span<const uint16_t> span(prefs, num_prefs);
+  if (!meshvpn_sigalgs_cert_unique(span)) {
+    return 0;
+  }
+  return ctx->meshvpn_client_sigalgs_cert.CopyFrom(span) ? 1 : 0;
+}
