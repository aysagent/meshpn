# meshvpn device — common defaults

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

CONFIG_FREERTOS_HZ=1000
CONFIG_MESHVPN_NCM_TELEMETRY=y
CONFIG_MESHVPN_USB_TX_QUEUE=y
CONFIG_MESHVPN_USB_TX_EVENT_WAIT=y
# Headroom for the meshvpn_log vprintf hook, which adds a stack frame to every
# ESP_LOG call made from these tasks.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=6144
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# Crash diagnostics: there is no serial console, so the panic reason has to
# survive the reboot and be readable over the web UI.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_CAPTURE_DRAM=y

# LWIP NAT (bridge + meshvpn_net)
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_L2_TO_L3_COPY=y
# This firmware routes IPv4 only; the input hook also rejects IPv6 if an older
# sdkconfig enables it.
# CONFIG_LWIP_IPV6 is not set
# Register only the custom USB interface; no service discovery on uplink.
# CONFIG_MDNS_PREDEF_NETIF_STA is not set
# CONFIG_MDNS_PREDEF_NETIF_AP is not set
# CONFIG_MDNS_PREDEF_NETIF_ETH is not set
CONFIG_MDNS_MAX_INTERFACES=2
CONFIG_LWIP_NETBUF_RECVINFO=y
CONFIG_LWIP_TCP_MSS=1360
CONFIG_LWIP_TCP_OVERSIZE_MSS=y
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=6144
# Throughput: larger windows for USB FS NAT path (MSS=1360 → ~12 segments)
CONFIG_LWIP_TCP_WND_DEFAULT=16320
# Phase 3a: asymmetric — larger send buf for upload (phone→WiFi NAT leg)
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
# Throughput phase 1: tcpip on CPU0 (TinyUSB stays CPU1), hot path in IRAM
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y
# Skip IP/UDP checksum verify on the forward path (CPU-bound NAT)
# CONFIG_LWIP_CHECKSUM_CHECK_IP is not set
# CONFIG_LWIP_CHECKSUM_CHECK_UDP is not set

# Runtime CPU/task telemetry exposed by /api/status. ESP timer keeps values in
# microseconds and is stable across the fixed 240 MHz CPU configuration.
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# HTTP server (meshvpn_web)
# Development default; enable in menuconfig for mandatory password rotation.
# CONFIG_MESHVPN_WEB_REQUIRE_PASSWORD_CHANGE is not set
# CONFIG_MESHVPN_WEB_HTTPS is not set
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_MBEDTLS_PEM_WRITE_C=y
CONFIG_LWIP_MAX_SOCKETS=24

# Disable BT (not needed)
CONFIG_BT_ENABLED=n

# meshvpn components
CONFIG_MESHVPN_BOARD_XIAO_ESP32S3=y

# meshvpn VPN (phase 2 stub)
CONFIG_MESHVPN_VPN_ENABLE=n

CONFIG_MESHVPN_USB_PROFILE_NCM=y

# ESP-IoT-Bridge: USB NIC and SoftAP share the WiFi STA uplink.
# Management remains USB-only; AP clients can use gateway DNS and IPv4 NAT.
CONFIG_BRIDGE_ENABLE=y
CONFIG_BRIDGE_DATA_FORWARDING_NETIF_USB=y
CONFIG_BRIDGE_EXTERNAL_NETIF_STATION=y
CONFIG_BRIDGE_STATION_CANCEL_AUTO_CONNECT_WHEN_DISCONNECTED=y
CONFIG_BRIDGE_DATA_FORWARDING_NETIF_SOFTAP=y
CONFIG_BRIDGE_SOFTAP_SSID="MeshPN"
CONFIG_BRIDGE_SOFTAP_SSID_END_WITH_THE_MAC=y
# Development/test password; change in menuconfig before non-test use.
CONFIG_BRIDGE_SOFTAP_PASSWORD="meshpn-test"
CONFIG_BRIDGE_SOFTAP_MAX_CONNECT_NUMBER=4

# Fallback DNS handed to LAN clients until the uplink reports the real one
CONFIG_BRIDGE_STATIC_DNS_SERVER_MAIN="8.8.8.8"
CONFIG_BRIDGE_STATIC_DNS_SERVER_BACKUP="1.1.1.1"

# USB subnet for host (clean-vpn compatible)
CONFIG_MESHVPN_USB_SUBNET_OCTET_2=7
