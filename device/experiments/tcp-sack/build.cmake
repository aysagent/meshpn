if("$ENV{MESHPN_EXPERIMENT_SACK}" STREQUAL "1")
    if(NOT CONFIG_IDF_TARGET_ESP32P4 OR NOT CONFIG_MESHVPN_PROFILED_TLS_ENABLE)
        message(FATAL_ERROR "SACK experiment requires profiled P4")
    endif()
    idf_component_get_property(sack_lwip lwip COMPONENT_LIB)
    idf_component_get_property(sack_dir lwip COMPONENT_DIR)
    idf_component_get_property(sack_vpn meshvpn_vpn COMPONENT_LIB)
    idf_build_get_property(sack_python PYTHON)
    set(sack_original "${sack_dir}/lwip/src/core/tcp_in.c")
    set(sack_script "${CMAKE_SOURCE_DIR}/experiments/tcp-sack/patch.py")
    set(sack_generated "${CMAKE_BINARY_DIR}/meshpn-generated/tcp_in.c")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${sack_original}" "${sack_script}")
    execute_process(COMMAND "${sack_python}" "${sack_script}" "${sack_original}" "${sack_generated}" RESULT_VARIABLE sack_result)
    if(NOT sack_result EQUAL 0)
        message(FATAL_ERROR "SACK experimental patch failed")
    endif()
    if("$ENV{MESHPN_EXPERIMENT_PARTIAL}" STREQUAL "1")
        set(partial_script "${CMAKE_SOURCE_DIR}/experiments/tcp-sack/partial.py")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${partial_script}")
        foreach(unit tcp_in tcp_out tcp)
            if(unit STREQUAL "tcp_in")
                set(original "${sack_generated}")
            else()
                set(original "${sack_dir}/lwip/src/core/${unit}.c")
            endif()
            execute_process(COMMAND "${sack_python}" "${partial_script}" "${original}" "${CMAKE_BINARY_DIR}/meshpn-generated/${unit}.c" RESULT_VARIABLE result)
            if(NOT result EQUAL 0)
                message(FATAL_ERROR "Partial ACK experiment failed")
            endif()
        endforeach()
    endif()
    get_target_property(sack_sources ${sack_lwip} SOURCES)
    set(sack_replaced "")
    set(sack_matches 0)
    foreach(source IN LISTS sack_sources)
        if(source MATCHES "(^|/)lwip/src/core/tcp_in\\.c$")
            list(APPEND sack_replaced "${sack_generated}")
            math(EXPR sack_matches "${sack_matches}+1")
        elseif("$ENV{MESHPN_EXPERIMENT_PARTIAL}" STREQUAL "1" AND source MATCHES "(^|/)lwip/src/core/(tcp|tcp_out)\\.c$")
            get_filename_component(unit "${source}" NAME)
            list(APPEND sack_replaced "${CMAKE_BINARY_DIR}/meshpn-generated/${unit}")
        else()
            list(APPEND sack_replaced "${source}")
        endif()
    endforeach()
    if(NOT sack_matches EQUAL 1)
        message(FATAL_ERROR "Expected one tcp_in source")
    endif()
    set_property(TARGET ${sack_lwip} PROPERTY SOURCES "${sack_replaced}")
    target_compile_definitions(${sack_vpn} PRIVATE MESHPN_EXPERIMENT_SACK=1)
endif()
