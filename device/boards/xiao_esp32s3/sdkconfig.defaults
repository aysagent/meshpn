# XIAO ESP32-S3 board defaults

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# PSRAM (ESP32-S3R8)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_TINYUSB_TASK_AFFINITY_CPU1=y
CONFIG_TINYUSB_INIT_IN_DEFAULT_TASK=y
# Throughput phase 2: faster usbd_defer_func → fewer USB TX retries
CONFIG_TINYUSB_TASK_PRIORITY=9

# TinyUSB device mode owns the USB PHY. Leaving USB-Serial-JTAG enabled makes
# iPhone Ethernet enumerate unreliably on some hosts.
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n

# Brownout: the board is often bus-powered by a phone, where the WiFi TX
# current spike can dip the rail. Log it instead of silently resetting.
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y
