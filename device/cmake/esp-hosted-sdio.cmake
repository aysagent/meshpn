# Patch only the pinned ESP-Hosted P4 SDIO source in the build directory.
if(CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE)
    idf_component_get_property(meshpn_hosted_lib espressif__esp_hosted COMPONENT_LIB)
    idf_component_get_property(meshpn_hosted_dir espressif__esp_hosted COMPONENT_DIR)
    idf_build_get_property(meshpn_hosted_python PYTHON)
    set(meshpn_sdio_original "${meshpn_hosted_dir}/host/drivers/transport/sdio/sdio_drv.c")
    set(meshpn_sdio_generator "${CMAKE_SOURCE_DIR}/scripts/patch-esp-hosted-sdio.py")
    set(meshpn_sdio_generated "${CMAKE_BINARY_DIR}/meshpn-generated/sdio_drv.c")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${meshpn_sdio_original}" "${meshpn_sdio_generator}")
    execute_process(COMMAND "${meshpn_hosted_python}" "${meshpn_sdio_generator}"
            "${meshpn_sdio_original}" "${meshpn_sdio_generated}"
        RESULT_VARIABLE meshpn_sdio_result ERROR_VARIABLE meshpn_sdio_error)
    if(NOT meshpn_sdio_result EQUAL 0)
        message(FATAL_ERROR "ESP-Hosted SDIO RX patch failed: ${meshpn_sdio_error}")
    endif()
    get_target_property(meshpn_hosted_sources ${meshpn_hosted_lib} SOURCES)
    set(meshpn_sdio_matches 0)
    set(meshpn_sdio_replaced "")
    foreach(meshpn_hosted_source IN LISTS meshpn_hosted_sources)
        if(meshpn_hosted_source MATCHES "(^|/)host/drivers/transport/sdio/sdio_drv\\.c$")
            list(APPEND meshpn_sdio_replaced "${meshpn_sdio_generated}")
            math(EXPR meshpn_sdio_matches "${meshpn_sdio_matches}+1")
        else()
            list(APPEND meshpn_sdio_replaced "${meshpn_hosted_source}")
        endif()
    endforeach()
    if(NOT meshpn_sdio_matches EQUAL 1)
        message(FATAL_ERROR "Expected one ESP-Hosted SDIO source, found ${meshpn_sdio_matches}")
    endif()
    set_property(TARGET ${meshpn_hosted_lib} PROPERTY SOURCES "${meshpn_sdio_replaced}")
    message(STATUS "MeshPN: ESP-Hosted SDIO streaming RX buffers reserved")

    set(meshpn_transport_original "${meshpn_hosted_dir}/host/drivers/transport/transport_drv.c")
    set(meshpn_transport_generator "${CMAKE_SOURCE_DIR}/scripts/patch-esp-hosted-transport.py")
    set(meshpn_transport_generated "${CMAKE_BINARY_DIR}/meshpn-generated/transport_drv.c")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${meshpn_transport_original}" "${meshpn_transport_generator}")
    execute_process(COMMAND "${meshpn_hosted_python}" "${meshpn_transport_generator}"
            "${meshpn_transport_original}" "${meshpn_transport_generated}"
        RESULT_VARIABLE meshpn_transport_result ERROR_VARIABLE meshpn_transport_error)
    if(NOT meshpn_transport_result EQUAL 0)
        message(FATAL_ERROR "ESP-Hosted transport TX patch failed: ${meshpn_transport_error}")
    endif()
    get_target_property(meshpn_hosted_sources ${meshpn_hosted_lib} SOURCES)
    set(meshpn_transport_matches 0)
    set(meshpn_transport_replaced "")
    foreach(meshpn_hosted_source IN LISTS meshpn_hosted_sources)
        if(meshpn_hosted_source MATCHES "(^|/)host/drivers/transport/transport_drv\\.c$")
            list(APPEND meshpn_transport_replaced "${meshpn_transport_generated}")
            math(EXPR meshpn_transport_matches "${meshpn_transport_matches}+1")
        else()
            list(APPEND meshpn_transport_replaced "${meshpn_hosted_source}")
        endif()
    endforeach()
    if(NOT meshpn_transport_matches EQUAL 1)
        message(FATAL_ERROR "Expected one ESP-Hosted transport source, found ${meshpn_transport_matches}")
    endif()
    set_property(TARGET ${meshpn_hosted_lib} PROPERTY SOURCES "${meshpn_transport_replaced}")
    message(STATUS "MeshPN: ESP-Hosted Wi-Fi TX handles DMA allocation failure")

    # 1.4.7 drops get_protocol()'s interface argument and two getters read
    # missing/failed RPC responses. Patch a copy; keep managed sources intact.
    set(meshpn_rpc_original "${meshpn_hosted_dir}/host/drivers/rpc/wrap/rpc_wrap.c")
    set(meshpn_rpc_generator "${CMAKE_SOURCE_DIR}/scripts/patch-esp-hosted-rpc.py")
    set(meshpn_rpc_generated "${CMAKE_BINARY_DIR}/meshpn-generated/rpc_wrap.c")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
        "${meshpn_rpc_original}" "${meshpn_rpc_generator}")
    execute_process(COMMAND "${meshpn_hosted_python}" "${meshpn_rpc_generator}"
            "${meshpn_rpc_original}" "${meshpn_rpc_generated}"
        RESULT_VARIABLE meshpn_rpc_result ERROR_VARIABLE meshpn_rpc_error)
    if(NOT meshpn_rpc_result EQUAL 0)
        message(FATAL_ERROR "ESP-Hosted RPC interface patch failed: ${meshpn_rpc_error}")
    endif()
    get_target_property(meshpn_hosted_sources ${meshpn_hosted_lib} SOURCES)
    set(meshpn_rpc_matches 0)
    set(meshpn_rpc_replaced "")
    foreach(meshpn_hosted_source IN LISTS meshpn_hosted_sources)
        if(meshpn_hosted_source MATCHES "(^|/)host/drivers/rpc/wrap/rpc_wrap\\.c$")
            list(APPEND meshpn_rpc_replaced "${meshpn_rpc_generated}")
            math(EXPR meshpn_rpc_matches "${meshpn_rpc_matches}+1")
        else()
            list(APPEND meshpn_rpc_replaced "${meshpn_hosted_source}")
        endif()
    endforeach()
    if(NOT meshpn_rpc_matches EQUAL 1)
        message(FATAL_ERROR "Expected one ESP-Hosted RPC wrapper, found ${meshpn_rpc_matches}")
    endif()
    set_property(TARGET ${meshpn_hosted_lib} PROPERTY SOURCES "${meshpn_rpc_replaced}")
endif()
