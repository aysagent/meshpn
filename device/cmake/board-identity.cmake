# Check resolved sdkconfig, not just the requested board/profile. In particular,
# menuconfig can leave a named NCM build with no CDC or with the wrong P4 PHY.
set(MESHVPN_BOARD_IDENTITY "${CMAKE_BINARY_DIR}/meshvpn-board.json")
file(REMOVE "${MESHVPN_BOARD_IDENTITY}")
string(TOUPPER "${MESHVPN_BOARD}" MESHVPN_BOARD_SYMBOL)
if(NOT CONFIG_MESHVPN_BOARD_${MESHVPN_BOARD_SYMBOL})
    message(FATAL_ERROR "sdkconfig board does not match BOARD=${MESHVPN_BOARD}")
endif()
if(NOT "${IDF_TARGET}" STREQUAL "${MESHVPN_BOARD_TARGET}")
    message(FATAL_ERROR "sdkconfig target does not match selected board")
endif()
if(NOT MESHVPN_USB_PROFILE MATCHES "^(ncm|ecm|rndis)$")
    message(FATAL_ERROR "Unsupported USB profile: ${MESHVPN_USB_PROFILE}")
endif()
string(TOUPPER "${MESHVPN_USB_PROFILE}" MESHVPN_USB_PROFILE_SYMBOL)
if(NOT CONFIG_MESHVPN_USB_PROFILE_${MESHVPN_USB_PROFILE_SYMBOL})
    message(FATAL_ERROR "sdkconfig USB profile does not match USB_PROFILE=${MESHVPN_USB_PROFILE}")
endif()
if(MESHVPN_USB_PROFILE STREQUAL "ncm")
    if(NOT CONFIG_TINYUSB_NET_MODE_NCM OR NOT CONFIG_TINYUSB_CDC_ENABLED OR
       NOT "${CONFIG_TINYUSB_CDC_COUNT}" STREQUAL "1")
        message(FATAL_ERROR "NCM auto-flash requires TinyUSB NCM with exactly one CDC interface")
    endif()
elseif(NOT CONFIG_TINYUSB_NET_MODE_ECM_RNDIS)
    message(FATAL_ERROR "ECM/RNDIS requires the matching TinyUSB network mode")
endif()
if(IDF_TARGET STREQUAL "esp32p4")
    if(NOT CONFIG_TINYUSB_RHPORT_HS)
        message(FATAL_ERROR "P4 board profiles require the dedicated USB HS controller")
    endif()
    if("$ENV{P4_REVISION}" STREQUAL "3")
        if(CONFIG_ESP32P4_SELECTS_REV_LESS_V3 OR CONFIG_ESP32P4_REV_MIN_FULL LESS 300)
            message(FATAL_ERROR "P4_REVISION=3 conflicts with sdkconfig revision family")
        endif()
    elseif("$ENV{P4_REVISION}" STREQUAL "" OR "$ENV{P4_REVISION}" STREQUAL "1")
        if(NOT CONFIG_ESP32P4_SELECTS_REV_LESS_V3 OR CONFIG_ESP32P4_REV_MIN_FULL GREATER_EQUAL 300)
            message(FATAL_ERROR "P4_REVISION=1 conflicts with sdkconfig revision family")
        endif()
    else()
        message(FATAL_ERROR "P4_REVISION must be 1 or 3")
    endif()
endif()
file(WRITE "${MESHVPN_BOARD_IDENTITY}"
    "{\"board\":\"${MESHVPN_BOARD}\",\"target\":\"${IDF_TARGET}\",\"profile\":\"${MESHVPN_USB_PROFILE}\"}\n")
