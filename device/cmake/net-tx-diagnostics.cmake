# Run after P4 RX instrumentation so both sets of hooks share one wlanif copy.
idf_build_get_property(meshpn_tx_python PYTHON)
foreach(meshpn_tx_kind IN ITEMS wlanif sockets)
    if(meshpn_tx_kind STREQUAL "wlanif")
        set(meshpn_tx_component esp_netif)
    else()
        set(meshpn_tx_component lwip)
    endif()
    idf_component_get_property(meshpn_tx_lib ${meshpn_tx_component} COMPONENT_LIB)
    idf_component_get_property(meshpn_tx_dir ${meshpn_tx_component} COMPONENT_DIR)
    get_target_property(meshpn_tx_sources ${meshpn_tx_lib} SOURCES)
    set(meshpn_tx_replaced "")
    set(meshpn_tx_matches 0)
    foreach(meshpn_source IN LISTS meshpn_tx_sources)
        if(meshpn_source MATCHES "(^|/)${meshpn_tx_kind}\\.c$")
            if(IS_ABSOLUTE "${meshpn_source}")
                set(meshpn_tx_original "${meshpn_source}")
            else()
                set(meshpn_tx_original "${meshpn_tx_dir}/${meshpn_source}")
            endif()
            set(meshpn_tx_generator "${CMAKE_SOURCE_DIR}/scripts/instrument-net-tx.py")
            set(meshpn_tx_generated "${CMAKE_BINARY_DIR}/meshpn-generated/tx-${meshpn_tx_kind}.c")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${meshpn_tx_original}" "${meshpn_tx_generator}")
            execute_process(COMMAND "${meshpn_tx_python}" "${meshpn_tx_generator}" "${meshpn_tx_kind}" "${meshpn_tx_original}" "${meshpn_tx_generated}"
                RESULT_VARIABLE meshpn_tx_result ERROR_VARIABLE meshpn_tx_error)
            if(NOT meshpn_tx_result EQUAL 0)
                message(FATAL_ERROR "TX instrumentation failed: ${meshpn_tx_error}")
            endif()
            list(APPEND meshpn_tx_replaced "${meshpn_tx_generated}")
            math(EXPR meshpn_tx_matches "${meshpn_tx_matches}+1")
        else()
            list(APPEND meshpn_tx_replaced "${meshpn_source}")
        endif()
    endforeach()
    if(NOT meshpn_tx_matches EQUAL 1)
        message(FATAL_ERROR "Expected one ${meshpn_tx_kind} source, got ${meshpn_tx_matches}")
    endif()
    set_property(TARGET ${meshpn_tx_lib} PROPERTY SOURCES "${meshpn_tx_replaced}")
    if(meshpn_tx_kind STREQUAL "wlanif")
        target_include_directories(${meshpn_tx_lib} PRIVATE "${meshpn_tx_dir}/lwip/netif")
    endif()
endforeach()
