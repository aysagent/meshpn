# P4 Hosted peers can repeat START while the disconnected STA is already added.
# Build a guarded copy; leave the shared ESP-IDF checkout unchanged.
idf_component_get_property(meshpn_netif_lib esp_netif COMPONENT_LIB)
idf_component_get_property(meshpn_netif_dir esp_netif COMPONENT_DIR)
idf_build_get_property(meshpn_netif_python PYTHON)
set(meshpn_netif_original "${meshpn_netif_dir}/lwip/esp_netif_lwip.c")
set(meshpn_netif_generator "${CMAKE_SOURCE_DIR}/scripts/patch-netif-start.py")
set(meshpn_netif_generated "${CMAKE_BINARY_DIR}/meshpn-generated/esp_netif_lwip.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${meshpn_netif_original}" "${meshpn_netif_generator}")
execute_process(COMMAND "${meshpn_netif_python}" "${meshpn_netif_generator}" "${meshpn_netif_original}" "${meshpn_netif_generated}"
    RESULT_VARIABLE meshpn_netif_result ERROR_VARIABLE meshpn_netif_error)
if(NOT meshpn_netif_result EQUAL 0)
    message(FATAL_ERROR "Netif start guard failed: ${meshpn_netif_error}")
endif()
get_target_property(meshpn_netif_sources ${meshpn_netif_lib} SOURCES)
set(meshpn_netif_replaced "")
set(meshpn_netif_matches 0)
foreach(source IN LISTS meshpn_netif_sources)
    if(source MATCHES "(^|/)lwip/esp_netif_lwip\\.c$")
        list(APPEND meshpn_netif_replaced "${meshpn_netif_generated}")
        math(EXPR meshpn_netif_matches "${meshpn_netif_matches}+1")
    else()
        list(APPEND meshpn_netif_replaced "${source}")
    endif()
endforeach()
if(NOT meshpn_netif_matches EQUAL 1)
    message(FATAL_ERROR "Expected one esp_netif_lwip.c, found ${meshpn_netif_matches}")
endif()
# Original file includes private headers from its source directory.
target_include_directories(${meshpn_netif_lib} PRIVATE "${meshpn_netif_dir}/lwip")
set_property(TARGET ${meshpn_netif_lib} PROPERTY SOURCES "${meshpn_netif_replaced}")
