# P4 only: preserve wlanif's exact buffer ownership and public return policy.
idf_component_get_property(meshpn_netif_lib esp_netif COMPONENT_LIB)
idf_component_get_property(meshpn_netif_dir esp_netif COMPONENT_DIR)
idf_build_get_property(meshpn_rx_python PYTHON)
target_include_directories(${meshpn_netif_lib} PRIVATE "${meshpn_netif_dir}/lwip/netif")
set(meshpn_rx_original "${meshpn_netif_dir}/lwip/netif/wlanif.c")
set(meshpn_rx_generator "${CMAKE_SOURCE_DIR}/scripts/instrument-wifi-rx.py")
set(meshpn_rx_generated "${CMAKE_BINARY_DIR}/meshpn-generated/wlanif.c")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${meshpn_rx_original}" "${meshpn_rx_generator}")
execute_process(COMMAND "${meshpn_rx_python}" "${meshpn_rx_generator}" "${meshpn_rx_original}" "${meshpn_rx_generated}"
    RESULT_VARIABLE meshpn_rx_result ERROR_VARIABLE meshpn_rx_error)
if(NOT meshpn_rx_result EQUAL 0)
    message(FATAL_ERROR "Wi-Fi RX instrumentation failed: ${meshpn_rx_error}")
endif()
get_target_property(meshpn_rx_sources ${meshpn_netif_lib} SOURCES)
set(meshpn_rx_replaced "")
set(meshpn_rx_matches 0)
foreach(meshpn_source IN LISTS meshpn_rx_sources)
    if(meshpn_source MATCHES "(^|/)lwip/netif/wlanif\\.c$")
        list(APPEND meshpn_rx_replaced "${meshpn_rx_generated}")
        math(EXPR meshpn_rx_matches "${meshpn_rx_matches}+1")
    else()
        list(APPEND meshpn_rx_replaced "${meshpn_source}")
    endif()
endforeach()
if(NOT meshpn_rx_matches EQUAL 1)
    message(FATAL_ERROR "Expected one wlanif source; found ${meshpn_rx_matches}")
endif()
set_property(TARGET ${meshpn_netif_lib} PROPERTY SOURCES "${meshpn_rx_replaced}")
