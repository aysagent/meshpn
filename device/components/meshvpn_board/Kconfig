menu "meshvpn Board"

    choice MESHVPN_BOARD
        prompt "Target board"
        default MESHVPN_BOARD_XIAO_ESP32S3

        config MESHVPN_BOARD_XIAO_ESP32S3
            bool "Seeed XIAO ESP32-S3"

        config MESHVPN_BOARD_M5_STAMP_P4_C6
            bool "M5Stack Stamp-P4 + C6 addon (scaffold)"
    endchoice

endmenu

menu "meshvpn USB"

    config MESHVPN_USB_SUBNET_OCTET_2
        int "USB host LAN third octet (192.168.X.0/24)"
        range 1 254
        default 7
        help
            USB-side LAN for connected host. Default 7 → 192.168.7.0/24
            (compatible with clean-vpn --client-lan-subnet).

    choice MESHVPN_USB_PROFILE
        prompt "USB network class"
        default MESHVPN_USB_PROFILE_NCM
        help
            Selected by profiles/usb_*.defconfig via ./device/scripts/flash.sh.

        config MESHVPN_USB_PROFILE_NCM
            bool "CDC-NCM (iPhone USB-C, modern macOS)"

        config MESHVPN_USB_PROFILE_RNDIS
            bool "RNDIS (Windows)"

        config MESHVPN_USB_PROFILE_ECM
            bool "CDC-ECM (Linux, legacy macOS)"
    endchoice

endmenu

menu "meshvpn WiFi"

    config MESHVPN_WIFI_HIGH_SPEED
        bool "Prefer 802.11n/HT40 high-speed mode"
        default y
        help
            Limit the radio to 802.11g/n (no legacy 802.11b) and request HT40
            on STA and SoftAP. This can improve throughput but may reduce
            compatibility with old access points or clients. The connected
            router still decides the actual channel width and PHY rate.

endmenu

menu "meshvpn Web"

    config MESHVPN_WEB_HTTPS
        bool "Enable HTTPS administration by default"
        default n
        help
            Initial mode when no HTTPS preference is saved in NVS. Both HTTP
            and HTTPS are built in; the admin checkbox overrides this default
            after reboot, without reflashing. HTTP credentials are unencrypted.

    config MESHVPN_WEB_REQUIRE_PASSWORD_CHANGE
        bool "Require changing the default admin password"
        default n
        help
            When enabled, a session using the default admin password may view
            status/logs and scan WiFi, but must change the password before
            changing configuration. Disabled for development/testing.

    config MESHVPN_WEB_ADMIN_PASSWORD_DEFAULT
        string "Default web admin password"
        default "admin"

endmenu
