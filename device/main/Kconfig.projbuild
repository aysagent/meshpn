menu "MeshPN diagnostic firmware"
config MESHVPN_USB_TX_QUEUE
    bool "Experimental bounded USB TX worker queue"
    depends on SPIRAM && !TINYUSB_MSC_ENABLED
    default n
    help
        Eight owned frame buffers in PSRAM, a 3KiB internal task stack and
        nonblocking lwIP enqueue. Sync fallback on allocation/task failure.
        Disable for comparison with the previous synchronous transport.

config MESHVPN_NCM_TELEMETRY
    bool "Passive NCM pool and transfer telemetry"
    depends on TINYUSB_NET_MODE_NCM
    default n
    help
        Instruments a build-directory copy of the pinned TinyUSB NCM driver.
        Measures pool occupancy and submit-to-callback time in TinyUSB task
        context. No payload logging or extra USB requests. Disable to measure
        instrumentation overhead; unavailable is reported instead of zeros.

config MESHVPN_USB_DIAGNOSTICS
    bool "Read-only diagnostic snapshots over the existing USB CDC interface"
    depends on TINYUSB_CDC_ENABLED
    default n
    help
        Allows the physically attached USB host to read buffered logs without
        admin authentication. No commands can modify settings or reboot.
        Debug only: disable for performance measurements and normal use.
endmenu
