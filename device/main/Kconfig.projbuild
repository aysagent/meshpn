menu "MeshPN diagnostic firmware"
config MESHVPN_DWC2_TELEMETRY
    bool "Experimental NCM DWC2 ISR and FIFO telemetry"
    depends on IDF_TARGET_ESP32S3 && MESHVPN_NCM_TELEMETRY
    default n
    help
        Read FIFO registers in the DCD, count FIFO writes, and time transfer
        submission to ISR completion and ISR to NCM callback. Adds overhead
        per FIFO refill; disable for a throughput baseline. No payload logs.

config MESHVPN_USB_NCM_DOUBLE_BUFFER
    bool "Experimental double hardware FIFO for NCM bulk IN"
    depends on IDF_TARGET_ESP32S3 && TINYUSB_NET_MODE_NCM
    depends on !TINYUSB_MSC_ENABLED && TINYUSB_CDC_COUNT <= 1 && TINYUSB_VENDOR_COUNT = 0
    default n
    help
        Configure the TinyUSB DWC2 controller before initialization to hold
        two 64-byte packets on the network IN endpoint (64 extra FIFO bytes).
        Does not enlarge frame queues, NTB pools or change event waits.
        Uses the default esp_tinyusb FS descriptor, as installed by iot_bridge.
        Disable to compare with the single-FIFO baseline.

config MESHVPN_USB_TX_EVENT_WAIT
    bool "Wait for NCM completion in the USB TX worker"
    depends on MESHVPN_USB_TX_QUEUE && MESHVPN_NCM_TELEMETRY
    default n
    help
        Replace rapid busy retries with task notifications after NCM IN
        completion. Capacity retry budget is 25ms; queue size is unchanged by
        this option.
        Only the worker waits. Disable to compare with the yield baseline.

config MESHVPN_USB_TX_QUEUE
    bool "Experimental bounded USB TX worker queue"
    depends on SPIRAM && !TINYUSB_MSC_ENABLED
    default n
    help
        Eight owned frame buffers in PSRAM, a 3KiB internal task stack and
        nonblocking lwIP enqueue. Sync fallback on allocation/task failure.
        Disable for comparison with the previous synchronous transport.

config MESHVPN_NCM_TELEMETRY
    bool "Passive NCM pool and transfer telemetry"
    depends on TINYUSB_NET_MODE_NCM
    default n
    help
        Instruments a build-directory copy of the pinned TinyUSB NCM driver.
        Measures pool occupancy and submit-to-callback time in TinyUSB task
        context. No payload logging or extra USB requests. Disable to measure
        instrumentation overhead; unavailable is reported instead of zeros.

config MESHVPN_USB_DIAGNOSTICS
    bool "Read-only diagnostic snapshots over the existing USB CDC interface"
    depends on TINYUSB_CDC_ENABLED
    default n
    help
        Allows the physically attached USB host to read buffered logs without
        admin authentication. No commands can modify settings or reboot.
        Debug only: disable for performance measurements and normal use.
endmenu
