{
  "name": "mesh-vpn",
  "version": "1.0.0",
  "description": "Decentralized mesh VPN with WebRTC, onion encryption, and multipath routing",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test:ingress-routing": "node --test scripts/test-ingress-routing.mjs scripts/test-ingress-journal.mjs",
    "test:ingress-routing-real": "node --test scripts/test-ingress-routing-real.mjs",
    "test:ingress-recovery-real": "node --test scripts/test-ingress-recovery-real.mjs",
    "test:ingress-restart-real": "node --test scripts/test-ingress-restart-real.mjs",
    "test:ingress-transport-real": "node --test scripts/test-ingress-transport-real.mjs",
    "start": "node src/index.js",
    "server": "node server/signalling-server.js",
    "client": "node src/index.js --role client",
    "relay": "node src/index.js --role relay",
    "exit": "node src/index.js --role exit",
    "dev": "concurrently -n server,client,exit \"npm run server\" \"npm run client\" \"npm run exit\"",
    "sig:exit": "concurrently -n server,exit \"npm run server\" \"npm run exit\"",
    "sig:client": "concurrently -n server,client \"npm run server\" \"npm run client\"",
    "nat:enable": "sudo ./scripts/nat-enable.sh",
    "nat:disable": "sudo ./scripts/nat-disable.sh",
    "build:tun-linux": "node-gyp rebuild -C native/tun_linux",
    "build:boring-tls-helper": "cmake -S native/boring_tls -B native/boring_tls/build -DCMAKE_BUILD_TYPE=Release && cmake --build native/boring_tls/build --target boring-tls-helper --parallel $(node -p \"Math.max(1, require('os').cpus().length - 1)\")",
    "build:boring-tls-helper-lowmem": "cmake -S native/boring_tls -B native/boring_tls/build -DCMAKE_BUILD_TYPE=Release && cmake --build native/boring_tls/build --target boring-tls-helper --parallel 1",
    "device:setup": "./device/scripts/setup-macos.sh",
    "device:flash": "./device/scripts/flash.sh",
    "device:flash:diag": "USB_DIAGNOSTICS=1 ./device/scripts/flash.sh",
    "device:flash:perf-control": "DWC2_TELEMETRY=0 ./device/scripts/flash.sh",
    "device:diag": "python3 device/scripts/usb-diag.py",
    "device:diag:test": "python3 -m unittest discover -s device/tests -p test_usb_diag.py",
    "device:flash:rndis": "./device/scripts/flash.sh rndis",
    "device:flash:ecm": "./device/scripts/flash.sh ecm",
    "device:monitor": "./device/scripts/monitor.sh",
    "device:remote": "./device/scripts/remote-tunnel.sh",
    "device:remote:connect": "./device/scripts/remote-connect.sh",
    "device:remote:repo": "node device/scripts/remote-repo.mjs",
    "device:remote:config": "node device/scripts/remote-config.mjs",
    "device:remote:collect": "node device/scripts/remote-collect.mjs",
    "device:remote:ap-test": "node device/scripts/remote-ap-test.mjs",
    "device:perf": "node device/scripts/perf-runner.mjs",
    "device:perf:ap-managed": "node device/scripts/perf-ap-managed.mjs",
    "device:perf:usb-down": "node device/scripts/perf-runner.mjs --usb-down-sweep",
    "device:perf:usb-bursts": "node device/scripts/perf-runner.mjs --usb-burst-sweep",
    "device:perf:ap-up": "node device/scripts/perf-runner.mjs --ap-tcp-up",
    "device:perf:ap-paced": "node device/scripts/perf-runner.mjs --ap-tcp-paced",
    "device:perf:usb-local": "node device/scripts/perf-local.mjs",
    "device:perf:test": "node --test device/tests/test-perf-runner.mjs device/tests/test-perf-local.mjs device/tests/test-perf-bursts.mjs device/tests/test-perf-wifi.mjs device/tests/test-perf-ap-managed.mjs",
    "ja3-snif-server": "node scripts/ja3-snif-server.mjs",
    "test:boring-tls-smoke": "node scripts/test-boring-tls-smoke.mjs",
    "test:tls-ja4": "node scripts/test-tls-clienthello-ja4.mjs",
    "test:transparent-tls-enc-sni": "node scripts/test-transparent-tls-enc-sni.mjs",
    "test:transparent-tls-integration": "node --test scripts/test-transparent-tls-integration.mjs",
    "test:transparent-tls-runtime": "node --test scripts/test-transparent-tls-runtime.mjs",
    "test:transparent-tls-retry": "node --test scripts/test-transparent-tls-retry.mjs",
    "test:transparent-tls-replay": "node --test scripts/test-transparent-tls-replay.mjs",
    "test:transparent-tls-destination": "node --test scripts/test-transparent-tls-destination.mjs",
    "test:transparent-dns": "node --test scripts/test-transparent-dns-lab.mjs",
    "transparent-tls:dns-lab": "node scripts/transparent-dns-lab.mjs",
    "transparent-tls:dns-soak": "node scripts/transparent-dns-soak.mjs",
    "test:dns-soak": "node --test scripts/test-dns-soak.mjs",
    "test:dns-soak-real": "node --test scripts/test-dns-soak-real.mjs",
    "test:dns-upstream-config": "node --test scripts/test-dns-upstream-config.mjs",
    "dns:check-upstream": "node scripts/dns-upstream-check.mjs",
    "dns:exit-adapter": "node scripts/dns-exit-adapter.mjs",
    "dns:lifecycle": "node scripts/dns-lifecycle.mjs",
    "dns:boot": "node scripts/dns-boot.mjs",
    "dns:vm-preflight": "node scripts/dns-vm-preflight.mjs",
    "dns:vm-lab": "node scripts/dns-vm-lab.mjs",
    "test:dns-vm": "node --test scripts/test-dns-vm.mjs",
    "test:dns-boot": "node --test scripts/test-dns-boot.mjs",
    "dns:inspect": "node scripts/dns-inspect.mjs",
    "dns:diagnostic": "node scripts/dns-diagnostic.mjs",
    "test:dns-diagnostic": "node --test scripts/test-dns-diagnostic.mjs",
    "test:dnsmasq-config": "node --test scripts/test-dnsmasq-config.mjs",
    "test:dnsmasq-journal": "node --test scripts/test-dnsmasq-journal.mjs",
    "test:dhcp-lab-wire": "node --test scripts/test-dhcp-lab-wire.mjs",
    "dns:dnsmasq-lab": "node scripts/dnsmasq-lab.mjs",
    "test:dnsmasq-real": "node --test scripts/test-dnsmasq-real.mjs",
    "dns:networkd-lab": "node scripts/dns-networkd-lab.mjs",
    "test:dns-networkd": "node --test scripts/test-dns-networkd.mjs",
    "test:dns-domain-policy": "node --test scripts/test-dns-domain-policy.mjs",
    "test:dns-owned-link": "node --test scripts/test-dns-owned-link.mjs",
    "test:dns-owned-link-real": "node --test scripts/test-dns-owned-link-real.mjs",
    "test:dns-networkd-real": "node --test scripts/test-dns-networkd-real.mjs",
    "test:dns-inspect": "node --test scripts/test-dns-inspect.mjs",
    "test:dns-resolved": "node --test scripts/test-dns-resolved.mjs",
    "test:dns-resolved-real": "node --test scripts/test-dns-resolved-real.mjs",
    "test:dns-resolved-journal": "node --test scripts/test-dns-resolved-journal.mjs",
    "test:dns-resolved-journal-real": "node --test scripts/test-dns-resolved-journal-real.mjs",
    "test:dns-adapter-process": "node --test scripts/test-dns-adapter-process.mjs",
    "test:dns-adapter-process-real": "node --test scripts/test-dns-adapter-process-real.mjs",
    "dns:lifecycle-lab": "node scripts/dns-lifecycle-lab.mjs",
    "test:dns-lifecycle": "node --test scripts/test-dns-lifecycle.mjs",
    "test:dns-lifecycle-real": "node --test scripts/test-dns-lifecycle-real.mjs",
    "test:dns-lifecycle-journal": "node --test scripts/test-dns-lifecycle-journal.mjs",
    "test:dns-lifecycle-crash-real": "node --test scripts/test-dns-lifecycle-crash-real.mjs",
    "test:dns-exit-adapter": "node --test scripts/test-dns-exit-adapter.mjs",
    "test:dns-exit-adapter-real": "node --test scripts/test-dns-exit-adapter-real.mjs",
    "dns:adapter-soak": "node scripts/dns-adapter-soak.mjs",
    "test:dns-adapter-soak": "node --test scripts/test-dns-adapter-soak.mjs",
    "test:dns-adapter-soak-real": "node --test scripts/test-dns-adapter-soak-real.mjs",
    "test:dns-upstream-route": "node --test scripts/test-dns-upstream-route.mjs",
    "test:dns-upstream-route-real": "node --test scripts/test-dns-upstream-route-real.mjs",
    "test:transparent-tls-resumption": "node --test scripts/test-transparent-tls-resumption.mjs",
    "test:transparent-tls-early-data": "node --test scripts/test-transparent-tls-early-data.mjs",
    "test:transparent-tls-ech": "node --test scripts/test-transparent-tls-ech.mjs",
    "transparent-tls:lab": "node scripts/transparent-tls-lab.mjs",
    "test:transparent-connect": "node --test scripts/test-transparent-connect-lab.mjs",
    "test:transparent-browser": "node scripts/transparent-browser-lab.mjs",
    "test:browser-pcap": "node --test scripts/test-browser-lab-pcap.mjs",
    "test:transparent-load": "node --test scripts/test-transparent-tls-load.mjs",
    "test:browser-process": "node --test scripts/test-browser-lab-process.mjs",
    "transparent-tls:browser-soak": "node scripts/transparent-browser-soak.mjs",
    "test:browser-soak": "node --test scripts/test-browser-soak.mjs",
    "test:browser-soak-real": "node --test scripts/test-browser-soak-real.mjs",
    "test:transparent-acceptance": "node --test scripts/test-transparent-acceptance.mjs",
    "transparent-tls:acceptance": "node scripts/transparent-acceptance.mjs",
    "transparent-tls:soak": "node scripts/transparent-soak.mjs",
    "test:transparent-soak": "node --test scripts/test-transparent-soak.mjs",
    "test:transparent-slow-reader": "node --test scripts/test-transparent-slow-reader.mjs",
    "test:transparent-h2-flow": "node --test scripts/test-transparent-h2-flow.mjs",
    "test:transparent-h2-goaway": "node --test scripts/test-transparent-h2-goaway.mjs",
    "test:boring-tls": "node scripts/test-boring-tls-smoke.mjs",
    "postinstall": "npm run build:tun-linux || true; cd helpers && make 2>/dev/null || true"
